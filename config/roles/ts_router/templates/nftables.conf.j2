#!/usr/sbin/nft -f

flush ruleset

table inet filter {
  chain input {
    type filter hook input priority 0; policy accept;
  }

  chain forward {
    type filter hook forward priority 0; policy drop;

    ct state established,related accept

    iifname "{{ ts_router_tailscale_iface }}" oifname "{{ ts_router_lan_iface }}" accept
    iifname "{{ ts_router_lan_iface }}" oifname "{{ ts_router_tailscale_iface }}" accept
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}

table inet nat {
  chain postrouting {
    type nat hook postrouting priority 100; policy accept;
    oifname "{{ ts_router_lan_iface }}" masquerade
  }
}
