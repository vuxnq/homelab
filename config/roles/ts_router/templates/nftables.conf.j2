#!/usr/sbin/nft -f

flush ruleset

table inet filter {
  chain input {
    type filter hook input priority 0; policy accept;

    iifname "{{ ts_router_home_iface }}" ct state established,related accept
    iifname "{{ ts_router_home_iface }}" udp sport 67 udp dport 68 accept
    iifname "{{ ts_router_home_iface }}" meta l4proto { icmp, icmpv6 } accept
    iifname "{{ ts_router_home_iface }}" drop
  }

  chain forward {
    type filter hook forward priority 0; policy drop;

    ct state established,related accept

    iifname "{{ ts_router_tailscale_iface }}" oifname "{{ ts_router_internal_iface }}" accept
    iifname "{{ ts_router_internal_iface }}" oifname "{{ ts_router_tailscale_iface }}" accept

{% for f in ts_router_forwards %}
    iifname "{{ ts_router_home_iface }}" oifname "{{ ts_router_internal_iface }}" ip daddr {{ f.to }} {{ f.proto }} dport {{ f.to_port | default(f.port) }} accept
{% endfor %}
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}

table inet nat {
  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
{% for f in ts_router_forwards %}
    iifname "{{ ts_router_home_iface }}" {{ f.proto }} dport {{ f.port }} dnat ip to {{ f.to }}:{{ f.to_port | default(f.port) }}
{% endfor %}
  }

  chain postrouting {
    type nat hook postrouting priority 100; policy accept;
    oifname "{{ ts_router_internal_iface }}" masquerade
  }
}
