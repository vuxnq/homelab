{
  email {$ACME_EMAIL}
  acme_ca https://acme.zerossl.com/v2/DV90
}

(porkbun) {
  tls {
    dns porkbun {
      api_key {$PORKBUN_API_KEY}
      api_secret_key {$PORKBUN_API_SECRET_KEY}
    }
  }
}

(app) {
  @{args[1]} host {args[1]}.{args[0]}.vuxnq.me
  handle @{args[1]} {
    reverse_proxy {args[2]}
  }
}

tux.vuxnq.me, *.tux.vuxnq.me {
  import porkbun

  @root host tux.vuxnq.me
  handle @root {
    reverse_proxy glance:8080
  }

  @proxmox host proxmox.tux.vuxnq.me
  handle @proxmox {
    reverse_proxy https://10.0.0.1:8006 {
      transport http {
        tls_insecure_skip_verify
      }
    }
  }

  import app tux gatus gatus:8080
  import app tux immich immich_server:2283
  import app tux dufs dufs:5000
  import app tux pihole {$PIHOLE_IP}:80
  import app tux syncthing syncthing:8384

  handle {
    abort
  }
}

share.vuxnq.me:8443, *.share.vuxnq.me:8443 {
  import porkbun

  import app share immich immich_server:2283
  import app share dufs dufs:5000

  handle {
    abort
  }
}
